      "type": "regex",
      "file": "script.js",
      "pattern": "^(?=[\\s\\S]*(?:\\bball\\s*\\.\\s*(?:x|pos\\s*\\.\\s*x)\\s*(?:\\+=\\s*\\(?\\s*vx\\b|=(?!=)\\s*\\(?\\s*(?:ball\\s*\\.\\s*(?:x|pos\\s*\\.\\s*x)\\s*\\+\\s*\\(?\\s*vx|vx\\s*\\+\\s*ball\\s*\\.\\s*(?:x|pos\\s*\\.\\s*x))\\b)|\\bball\\s*\\.\\s*vel\\s*\\.\\s*x\\s*=(?!=)\\s*vx\\b))(?=[\\s\\S]*(?:\\bball\\s*\\.\\s*(?:y|pos\\s*\\.\\s*y)\\s*(?:\\+=\\s*\\(?\\s*vy\\b|=(?!=)\\s*\\(?\\s*(?:ball\\s*\\.\\s*(?:y|pos\\s*\\.\\s*y)\\s*\\+\\s*\\(?\\s*vy|vy\\s*\\+\\s*ball\\s*\\.\\s*(?:y|pos\\s*\\.\\s*y))\\b)|\\bball\\s*\\.\\s*vel\\s*\\.\\s*y\\s*=(?!=)\\s*vy\\b))",
      "flags": "",
      "ignoreStrings": true,
      "points": 0,
      "status": "pending"
    },
