flowchart TD
  A([Start])
  B[/Input n and bankName/]
  C{{i = 1 to n}}
  D{i <= n?}
  E{Is i a multiple of 3?}
  F[Flip locker i]
  G[Set final state of locker 7]
  H[/Print state and open count/]
  Z([End])
  A --> B
  B --> C
  C --> D
  D -- Yes, enter the row --> E
  D -- No, row is done --> G
  E -- Multiple of 3, skip --> C
  E -- Not a multiple --> F
  F --> C
  G --> H
  H --> Z