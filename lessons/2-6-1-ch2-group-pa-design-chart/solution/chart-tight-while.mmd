flowchart TD
  A([Start])
  B[/Input n and bankName/]
  C{Is n less than 1?}
  D[/Report a bad n/]
  E[SET i = 1]
  F{i <= n?}
  G{Is i a multiple of 3?}
  H[Flip locker i]
  I[SET i = i + 1]
  J[Look up the state of locker 7]
  K{Is locker 7 open?}
  L[Set the verdict to open]
  M{Is locker 7 closed?}
  N[Set the verdict to closed]
  O[Set the verdict to never touched]
  P[/Print the verdict and the open count/]
  Z([End])
  A --> B
  B --> C
  C -- "Yes, bad n" --> D
  C -- "No, n is fine" --> E
  D --> Z
  E --> F
  F -- "Yes, more lockers" --> G
  F -- "No, row is done" --> J
  G -- "Multiple of 3, skip" --> I
  G -- "Not a multiple" --> H
  H --> I
  I --> F
  J --> K
  K -- "Open" --> L
  K -- "Not open" --> M
  M -- "Closed" --> N
  M -- "Never touched" --> O
  L --> P
  N --> P
  O --> P
  P --> Z
