flowchart TD
  A([Start])
  B[/Input stepsGoal, stepsSoFar, walkerName/]
  C{{d = 1 to 7}}
  D{Is d within the week?}
  E[Add today's steps to stepsSoFar]
  F[Set remaining to stepsGoal minus stepsSoFar]
  G{Is remaining below zero?}
  H[/Print status: exceeded, met, or not reached/]
  Z([End])
  A --> B
  B --> C
  C --> D
  D -- Yes, count the day --> E
  D -- No, week is over --> F
  E --> C
  F --> G
  G -- Yes, passed the goal --> H
  G -- No, still walking --> H
  H --> Z