flowchart TD
  A([Start])
  B[[loadStock]]
  C{Was a saved list found?}
  D[[makeItem name price qty]]
  E[Set the shack name and the reorder level]
  F[[totalValue list]]
  G[[lowStock list level]]
  H{Is anything low?}
  I[/Show the low-stock list/]
  J[Note that nothing is low]
  K[[receiptLines list]]
  L{{i = 0 to lines.length - 1}}
  M[/Show line i/]
  N[[sellItem list name]]
  O[/Show the total, the shack name and the new quantity/]
  P[[saveStock list]]
  Z([End])
  A --> B
  B --> C
  C -- "Yes, use it" --> E
  C -- "No, seed it" --> D
  D --> E
  E --> F
  F --> G
  G --> H
  H -- "Some are low" --> I
  H -- "All stocked" --> J
  I --> K
  J --> K
  K --> L
  L -- "More lines" --> M
  M --> L
  L -- "Lines are done" --> N
  N --> O
  O --> P
  P --> Z
