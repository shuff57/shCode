graphify-out/graph.json merge=graphify

# Vendored minified libraries. These are byte-exact upstream artifacts, hash-
# pinned in scripts/jscad-checks.mjs and verified against unpkg. With Windows
# core.autocrlf=true git rewrites every LF on checkout — measured: the modeling
# bundle came back 252016 bytes instead of 250793, a different file from the one
# that was vendored, and the hash check goes red on a fresh clone. Never let git
# translate these.
public/reshape/lib/*.js -text

# The preview runners. The gate cuts the scope shim live out of these files and
# matches on newline boundaries, so a CRLF checkout used to collapse the whole
# SHIM group. scripts/jscad-harness.mjs normalises on read so the gate no longer
# depends on this — keeping the working tree consistent as well is belt and
# braces, and stops the whole file showing as changed on a Windows clone.
public/reshape/runner.html  text eol=lf
public/moshion/runner.html  text eol=lf
