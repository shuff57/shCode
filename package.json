{
  "name": "shcode",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "prebuild": "node scripts/generate-lessons-manifest.mjs && node scripts/generate-solutions.mjs && node scripts/generate-lesson-starters.mjs && npm run slides:build-all",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "test": "echo \"No tests\"",
    "slides:build-all": "npm run slides:2.1:build && npm run slides:2.2:build && npm run slides:2.3:build && npm run slides:2.4:build && npm run slides:2.5:build && node scripts/strip-slide-externals.mjs",
    "slides:2.1": "slidev slides/2.1/slides.md --port 3030",
    "slides:2.1:build": "slidev build slides/2.1/slides.md --base /slides/2.1/ --out ../../public/slides/2.1",
    "slides:2.1:export": "slidev export slides/2.1/slides.md --output slides/2.1/export.pdf",
    "slides:2.2": "slidev slides/2.2/slides.md --port 3031",
    "slides:2.2:build": "slidev build slides/2.2/slides.md --base /slides/2.2/ --out ../../public/slides/2.2",
    "slides:2.2:export": "slidev export slides/2.2/slides.md --output slides/2.2/export.pdf",
    "slides:2.3": "slidev slides/2.3/slides.md --port 3032",
    "slides:2.3:build": "slidev build slides/2.3/slides.md --base /slides/2.3/ --out ../../public/slides/2.3",
    "slides:2.3:export": "slidev export slides/2.3/slides.md --output slides/2.3/export.pdf",
    "slides:2.4": "slidev slides/2.4/slides.md --port 3033",
    "slides:2.4:build": "slidev build slides/2.4/slides.md --base /slides/2.4/ --out ../../public/slides/2.4",
    "slides:2.4:export": "slidev export slides/2.4/slides.md --output slides/2.4/export.pdf",
    "slides:2.5": "slidev slides/2.5/slides.md --port 3034",
    "slides:2.5:build": "slidev build slides/2.5/slides.md --base /slides/2.5/ --out ../../public/slides/2.5",
    "slides:2.5:export": "slidev export slides/2.5/slides.md --output slides/2.5/export.pdf"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@types/diff": "^7.0.2",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "express": "^4.21.2",
    "isomorphic-dompurify": "^3.19.0",
    "jose": "^5.9.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.539.0",
    "marked": "^18.0.9",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-arborist": "^3.4.3",
    "react-dom": "^19.1.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250424.0",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/nunito-sans": "^5.2.7",
    "@slidev/cli": "^52.14.2",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4",
    "wrangler": "^4.87.0"
  }
}
