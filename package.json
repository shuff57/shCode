{
  "name": "shcode",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "prebuild": "node scripts/generate-lessons-manifest.mjs && npm run slides:build-all",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "test": "echo \"No tests\"",
    "slides:build-all": "npm run slides:2.1:build && npm run slides:2.2:build",
    "slides:2.1": "slidev slides/2.1/slides.md --port 3030",
    "slides:2.1:build": "slidev build slides/2.1/slides.md --base /slides/2.1/ --out ../../public/slides/2.1",
    "slides:2.1:export": "slidev export slides/2.1/slides.md --output slides/2.1/export.pdf",
    "slides:2.2": "slidev slides/2.2/slides.md --port 3031",
    "slides:2.2:build": "slidev build slides/2.2/slides.md --base /slides/2.2/ --out ../../public/slides/2.2",
    "slides:2.2:export": "slidev export slides/2.2/slides.md --output slides/2.2/export.pdf"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "isomorphic-dompurify": "^3.9.0",
    "jose": "^5.9.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.539.0",
    "marked": "^18.0.2",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-arborist": "^3.4.3",
    "react-dom": "^19.1.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250424.0",
    "@slidev/cli": "^52.14.2",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4",
    "wrangler": "^3.90.0"
  }
}
